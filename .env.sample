# Copy this to .env for local development (never commit .env!)
# These are set automatically in Azure by Bicep outputs via azd.

# Azure AI Foundry project endpoint
# Format: https://<account-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=

# GPT-4o deployment name in your Foundry project
FOUNDRY_MODEL_NAME=gpt-4o

# Existing Azure SQL Database
SQL_SERVER=nh-sql-external.database.windows.net
SQL_DATABASE=sqldb-hcc-g36o34t3bsjyc

# Application Insights (set automatically in Container Apps by Bicep)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# For local development only: use az login / VS Code credential.
# In Container Apps, DefaultAzureCredential picks up the system-assigned MI automatically.
